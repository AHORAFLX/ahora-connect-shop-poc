# URL base de AHORA Connect, sin /webapi. Sin CONNECT_URL arranca en modo demo (ERP simulado)
CONNECT_URL=https://connect.miempresa.com
CONNECT_USER=usuario_api
CONNECT_PASSWORD=cambiar

# Valores del ERP: ajústalos a tu instalación (ver la tabla de configuración en el README)
ID_EMPRESA=1
SERIE_PEDIDO=1
ID_MONEDA=1
ID_ALMACEN=0
ID_IVA=1
ID_IMPUESTO=1
# Forma de pago de los pedidos (opcional). Sin ella van al contado y la factura no genera vencimientos (efectos)
FORMA_PAGO=
PORT=3000
